<?xml version="1.0"?>
<sdf version="1.9">

  <model name="simple_box">

    <!-- Satu link utama untuk model kotak -->
    <link name="body">

      <!-- Properti fisik -->
      <inertial>

        <mass>1.0</mass>

        <inertia>
          <ixx>0.0266667</ixx>
          <iyy>0.0266667</iyy>
          <izz>0.0266667</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>

      <!-- Geometri untuk perhitungan tumbukan -->
      <collision name="collision">

        <geometry>
          <box>
            <size>0.4 0.6 1</size>
          </box>
        </geometry>

      </collision>

      <!-- Geometri untuk visualisasi -->
      <visual name="visual">

        <geometry>
          <box>
            <size>0.4 0.4 0.4</size>
          </box>
        </geometry>

        <material>
          <ambient>0.2 0.5 0.9 1</ambient>
          <diffuse>0.2 0.5 0.9 1</diffuse>
        </material>

      </visual>

    </link>

  </model>

</sdf>